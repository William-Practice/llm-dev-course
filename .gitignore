# ── 虚拟环境（各 1-7GB，绝不上传）──
venv/
*/venv/
helloGLM/
__pycache__/
*.py[cod]

# ── 独立仓库（knowledge_base 有自己的 remote，单独管理）──
knowledge_base/

# ── 训练中间产物（optimizer.pt 单个 70-140MB，只保留最终 adapter）──
